# Link ulasan Google Business Profile Warkop Dua Tujuh
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=ISI_PLACE_ID_ANDA

# Bot Telegram untuk laporan harian (dipakai di app/api/telegram/route.ts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase (opsional). Kalau dikosongkan, app fallback pakai localStorage
# seperti sebelumnya. Isi setelah menjalankan supabase/schema.sql di
# Supabase Dashboard → SQL Editor. Didapat dari Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
